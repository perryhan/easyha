# ============================================================
# EasyHA H618 · 内核配置片段
# 放入 fork: buildroot-external/board/allwinner/kernel-h618.config
# 说明：这是「片段」，与 fork 自带的通用内核配置合并；
#       首次接入后用 `make linux-menuconfig` 实测校准，把生效值固化回来。
# ============================================================

# --- Allwinner sun50i (H616/H618) 平台 ---
CONFIG_ARCH_SUNXI=y
CONFIG_SUN50I_IOMMU=y

# --- 以太网（EMAC1，mdio-mux 内置于 DTS） ---
CONFIG_DWMAC_SUN8I=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y

# --- eMMC / SD（mmc0=TF, mmc1=SDIO WiFi, mmc2=eMMC） ---
CONFIG_MMC_SUNXI=y
CONFIG_MMC_BLOCK_MINORS=32

# --- WiFi 基础设施（外部驱动 aic8800 依赖） ---
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=y

# --- USB（H616: EHCI/OHCI + MUSB） ---
CONFIG_USB=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_MUSB_SUNXI=y

# --- 常用外设 ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_RTC_DRV_SUN6I=y
CONFIG_WATCHDOG=y
CONFIG_SUNXI_WATCHDOG=y

# --- HAOS 只读系统要求：squashfs/overlayfs 由通用配置提供，勿在此重复 ---
