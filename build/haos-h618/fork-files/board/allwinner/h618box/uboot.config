# ============================================================
# EasyHA H618 盒子 · U-Boot defconfig
# 放入 fork: buildroot-external/board/allwinner/h618box/uboot.config
#
# 路线定案：走主线（不使用冬瓜 fork 源码）。基线 = 主线 U-Boot 2024.01。
# 依据：手板（H618 PCDN 公版）实测即运行主线 U-Boot 2024.01（SPL 2024.01），
# H616/Zero3 支持与 1.5GB 内存识别修复均已包含。
#
# DRAM 校准流程（自建路线必须自己做）：
#   1. 先用本文件的 Zero3 4GB 参数起步（本板为 4GB DDR3 公版）
#   2. 镜像写 TF 卡（BootROM 优先 TF，不动 eMMC 现有系统），插上 ttyS0 串口
#   3. 看串口 SPL/DRAM 输出：能打印 DRAM 容量且内核正常启动 → 参数可跑
#   4. 稳定性问题（偶发不开机/训练失败）→ 向板厂索要 DRAM 颗粒时序（TPR 等）
#      或用串口抓参照系统 U-Boot 阶段日志比对
# ============================================================

CONFIG_ARM=y
CONFIG_ARCH_SUNXI=y
CONFIG_MACH_SUN50I_H616=y
CONFIG_SUNXI_DRAM_H616=y

# ---- DRAM：4GB 目标容量（Zero3 4GB 版参数起步，❗串口实测后校准）----
CONFIG_DRAM_SUN50I_H616_DX_ODT=0x03030303
CONFIG_DRAM_SUN50I_H616_DX_DRI=0x0e0e0e0e
CONFIG_DRAM_SUN50I_H616_CA_DRI=0x0e0e
CONFIG_DRAM_SUN50I_H616_ODT_EN=0x7887bbbb
CONFIG_DRAM_SUN50I_H616_TPR6=0x33000000
CONFIG_DRAM_SUN50I_H616_TPR10=0x40273333
CONFIG_DRAM_SUN50I_H616_TPR11=0x0000001a
CONFIG_DRAM_SUN50I_H616_TPR12=0x00000014
CONFIG_DRAM_SUN50I_H616_PHY_INIT=1

# ---- 启动介质：eMMC（slot2）；TF 卡（slot0）作开发/恢复启动 ----
CONFIG_MMC0_CD_PIN="PF6"
CONFIG_MMC_SUNXI_SLOT_EXTRA=2

# ---- 调试串口（❗TODO 按原理图：H618 常见 PH0/PH1 或 PF2/PF4）----
CONFIG_CONS_INDEX=1

# ---- 设备树 ----
CONFIG_DEFAULT_DEVICE_TREE="sun50i-h618-easybox"

# ---- 与官方机器一致的通用项（vim3 模板同款）----
CONFIG_DOS_PARTITION=y
# CONFIG_EFI_PARTITION is not set
CONFIG_DISPLAY_BOARDINFO=y
