# ============================================================
# EasyHA H618 公版（DDR3L 4GB）· U-Boot 2026.04 覆盖片段
#
# 2026.04 的关键变化（相对旧教程）：
#   1. sunxi 已迁移 devicetree-rebasing：DEFAULT_DEVICE_TREE 必须带
#      `allwinner/` 前缀（dts/upstream/src/arm64/allwinner/）
#   2. DRAM 驱动符号更新为 CONFIG_DRAM_SUNXI_*；DDR3 用
#      CONFIG_SUNXI_DRAM_H616_DDR3_1333（基准值取自主线 zero2，同为 DDR3）
#   3. 容量由驱动运行时自动探测（zero3 单 defconfig 覆盖 1/1.5/2/4GB 同理），
#      公版 4GB 无需容量特配
#   4. 必须显式关闭 zero3 defconfig 自带的 LPDDR4（公版实测 dcdc3=1.356V → DDR3L）
#
# U-Boot 内部 DTS 用主线 zero3 的（其 UART0 PH/TF/eMMC 初始化与公版一致）；
# 传递给内核的 DTB 是 boot 分区的 sun50i-h618-easybox.dtb（boot.scr 显式加载）
# ============================================================

# ---- DRAM：DDR3-1333，参数基准取自主线 zero2（H616 DDR3 同族），按颗粒校准 ----
CONFIG_SUNXI_DRAM_H616_DDR3_1333=y
# CONFIG_SUNXI_DRAM_H616_LPDDR4 is not set
CONFIG_DRAM_SUNXI_DX_ODT=0x08080808
CONFIG_DRAM_SUNXI_DX_DRI=0x0e0e0e0e
CONFIG_DRAM_SUNXI_CA_DRI=0x0e0e
CONFIG_DRAM_SUNXI_TPR10=0xf83438

# ---- 启动介质 ----
CONFIG_MMC0_CD_PIN="PF6"
CONFIG_MMC_SUNXI_SLOT_EXTRA=2

# ---- 设备树（U-Boot 内部用；见头部说明）----
CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-h618-orangepi-zero3"

# ---- 与官方机器一致的通用项 ----
CONFIG_DOS_PARTITION=y
# CONFIG_EFI_PARTITION is not set
CONFIG_DISPLAY_BOARDINFO=y
