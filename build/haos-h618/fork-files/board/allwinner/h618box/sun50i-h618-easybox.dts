// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
// ============================================================
// EasyHA H618 公版盒子（PCDN 公版，DDR3L 4GB + Foresee eMMC 128G
// + RTL8211F 千兆 + AIC8801 USB WiFi）
//
// 结构与主线 sun50i-h618-orangepi-zero3.dts 完全同构：
//   基座 = sun50i-h616-orangepi-zero.dtsi（串口/mmc0/USB/公共调压器）
//   覆盖值全部来自参照系统 DTB（pcdn）反编译实测，见 pcdn-reference.dts
// ============================================================

/dts-v1/;

#include "sun50i-h616-orangepi-zero.dtsi"
#include "sun50i-h616-cpu-opp.dtsi"

/ {
	model = "EasyHA Box (H618)";
	compatible = "easyha,h618-box", "allwinner,sun50i-h618";
};

&cpu0 {
	cpu-supply = <&reg_dcdc2>;
};

/* ---- PMIC AXP313a @ r_i2c（与 zero3 同位置；无中断脚，轮询模式） ---- */
&r_i2c {
	status = "okay";

	axp313: pmic@36 {
		compatible = "x-powers,axp313a";
		reg = <0x36>;
		#interrupt-cells = <1>;
		interrupt-controller;

		vin1-supply = <&reg_vcc5v>;
		vin2-supply = <&reg_vcc5v>;
		vin3-supply = <&reg_vcc5v>;

		regulators {
			reg_aldo1: aldo1 {
				regulator-always-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc1v8";
			};

			reg_dldo1: dldo1 {
				regulator-always-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc3v3";
			};

			reg_dcdc1: dcdc1 {
				regulator-always-on;
				regulator-min-microvolt = <810000>;
				regulator-max-microvolt = <990000>;
				regulator-name = "vdd-gpu-sys";
			};

			reg_dcdc2: dcdc2 {
				regulator-always-on;
				regulator-min-microvolt = <810000>;
				regulator-max-microvolt = <1100000>;
				regulator-name = "vdd-cpu";
			};

			/* 公版 DDR3L：1.356V（zero3 LPDDR4 是 1.1V，必须覆盖） */
			reg_dcdc3: dcdc3 {
				regulator-always-on;
				regulator-min-microvolt = <1356000>;
				regulator-max-microvolt = <1356000>;
				regulator-name = "vdd-dram";
			};
		};
	};
};

&pio {
	vcc-pc-supply = <&reg_dldo1>;
	vcc-pf-supply = <&reg_dldo1>;
	vcc-pg-supply = <&reg_aldo1>;
	vcc-ph-supply = <&reg_dldo1>;
	vcc-pi-supply = <&reg_dldo1>;
};

/* ---- TF 卡（zero.dtsi 已配 broken-cd；补充供电轨） ---- */
&mmc0 {
	vmmc-supply = <&reg_dldo1>;
};

/* ---- eMMC：Foresee NG2M212 128GB，DDR52 @150MHz（参照实测，非 HS200） ---- */
&mmc2 {
	vmmc-supply = <&reg_dldo1>;
	vqmmc-supply = <&reg_dldo1>;
	bus-width = <8>;
	non-removable;
	cap-mmc-highspeed;
	mmc-ddr-3_3v;
	max-frequency = <150000000>;
	status = "okay";
};

/* ---- 千兆网口：RTL8211F（时延/模式/供电取自参照实测） ---- */
&emac0 {
	allwinner,rx-delay-ps = <3100>;
	allwinner,tx-delay-ps = <700>;
	phy-mode = "rgmii";
	phy-supply = <&reg_dldo1>;
};

&ext_rgmii_phy {
	/* RTL8211F 不需要 zero.dtsi 里 YT8531 的时钟输出属性 */
	/delete-property/ motorcomm,clk-out-frequency-hz;
};

/* ---- USB：usbotg 转 host（AIC8801 等 USB 设备）+ 三对 EHCI/OHCI ---- */
&usbotg {
	dr_mode = "host";
};

&usbphy {
	status = "okay";
};

&ehci0 {
	status = "okay";
};

&ohci0 {
	status = "okay";
};

&ehci2 {
	status = "okay";
};

&ohci2 {
	status = "okay";
};

/* 公版 USB 供电无独立使能脚：去掉 zero.dtsi 的 PC16 GPIO 控制，改为常供 */
&reg_usb1_vbus {
	/delete-property/ gpio;
	/delete-property/ enable-active-high;
};
